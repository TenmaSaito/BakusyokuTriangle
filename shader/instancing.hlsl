//==================================================================================
// 
// インスタンシング描画用のシェーダーファイル [instancing.hlsl]
// Author : TENMA SAITO
// 
//==================================================================================
//**********************************************************************************
// *** パラメータ宣言 ***
//**********************************************************************************
float4x4 g_mViewProj;		// 座標変換行列
float3 g_vCamUp;		// カメラの上ベクトル
float3 g_vCamRight;		// カメラの右ベクトル
texture g_texture;		// テクスチャ

//**********************************************************************************
// *** テクスチャサンプラー ***
//**********************************************************************************
sampler texSampler = sampler_state
{
	Texture = <g_texture>;
	MinFilter = LINEAR; 
	MagFilter = LINEAR; 
	MipFilter = LINEAR;
};

//**********************************************************************************
// *** 頂点シェーダーで受け取る情報構造体 ***
//**********************************************************************************
struct VS_INPUT
{
	// VERTEX_GEOMETRY
	float3 posVtx : POSITION0;		// 頂点座標
	float2 tex : TEXCOORD0;			// テクスチャ座標

	// VERTEX_INSTANCE
	float3 posWorld : POSITION1;	// 絶対座標
	float fRadius : TEXCOORD1;		// 半径
	float4 col : COLOR0;			// 色
};

//**********************************************************************************
// *** 頂点シェーダーで出力する情報構造体 ***
//**********************************************************************************
struct VS_OUTPUT
{
	float4 pos : POSITION;		// 位置
	float4 col : COLOR;			// 頂点カラー
	float2 tex : TEXCOORD0;		// テクスチャ座標
};

//==================================================================================
// --- 頂点シェーダー処理 ---
//==================================================================================
VS_OUTPUT VS_Main(VS_INPUT input)
{
	VS_OUTPUT output;		// 出力するデータ

	// 頂点座標計算
	float3 posWorld = input.posWorld
		+ g_vCamRight * (input.posVtx.x * input.fRadius)
		+ g_vCamUp * (input.posVtx.y * input.fRadius);
	output.pos = mul(float4(posWorld, 1.0), g_mViewProj);

	// 頂点カラー
	output.col = input.col;

	// テクスチャ座標
	output.tex = input.tex;
	return output;
}

//==================================================================================
// --- ピクセルシェーダー処理 ---
//==================================================================================
float4 PS_Main(VS_OUTPUT input) : COLOR0
{
	return tex2D(texSampler, input.tex) * input.col;
}

//==================================================================================
// --- シェーダーのコンパイル ---
//==================================================================================
technique Instancing
{
	pass P0
	{ // シェーダー
		VertexShader = compile vs_3_0 VS_Main();
		PixelShader = compile ps_3_0 PS_Main();
	}
}